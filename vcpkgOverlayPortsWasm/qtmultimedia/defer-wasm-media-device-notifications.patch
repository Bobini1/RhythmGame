+void QWasmMediaDevices::requestMediaDevicesEnumeration()
+{
+    // devicechange may be delivered while a synchronous native input export
+    // drains pending events, so this path must not suspend. Coalesce changes
+    // while an enumeration is pending so stale results cannot arrive last.
+    if (m_mediaDevicesEnumerationInFlight) {
+        m_mediaDevicesEnumerationDirty = true;
+        return;
+    }
+    m_mediaDevicesEnumerationInFlight = true;
+
+    qstdweb::PromiseCallbacks enumerateDevicesCallbacks{
+        .thenFunc =
+        [this](emscripten::val devices) {
+            parseDevices(devices);
+            finishMediaDevicesEnumeration();
+        },
+        .catchFunc =
+        [this](emscripten::val error) {
+            qWarning() << "mediadevices enumerateDevices fail"
+                       << QString::fromStdString(error["name"].as<std::string>())
+                       << QString::fromStdString(error["message"].as<std::string>());
+            m_initDone = false;
+            finishMediaDevicesEnumeration();
+        }
+    };
+
+    qstdweb::Promise::make(m_jsMediaDevicesInterface,
+                           QStringLiteral("enumerateDevices"),
+                           std::move(enumerateDevicesCallbacks));
+}
+
+void QWasmMediaDevices::finishMediaDevicesEnumeration()
+{
+    m_mediaDevicesEnumerationInFlight = false;
+    if (!m_mediaDevicesEnumerationDirty)
+        return;
+
+    m_mediaDevicesEnumerationDirty = false;
+    requestMediaDevicesEnumeration();
+}
