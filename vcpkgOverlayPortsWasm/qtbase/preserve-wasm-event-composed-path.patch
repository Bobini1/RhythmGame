+bool QEventDispatcherWasm::sendPendingNativeEventsFromBrowser()
+{
+    if (!emscripten_is_main_runtime_thread())
+        return false;
+    Q_ASSERT(emscripten_is_main_runtime_thread());
+
+    QWasmSuspendResumeControl *suspendResumeControl =
+            g_mainThreadSuspendResumeControl;
+    if (!suspendResumeControl)
+        return true;
+
+    const emscripten::val control =
+            QWasmSuspendResumeControl::suspendResumeControlJs();
+    if (control["exclusiveEventHandler"].as<int>() > 0)
+        return false;
+
+    const int deliveryDepthIncrement = useAsyncify() ? 1 : 0;
+    eventDeliveryDepth += deliveryDepthIncrement;
+    const auto eventDeliveryDepthGuard = qScopeGuard([deliveryDepthIncrement] {
+        Q_ASSERT(eventDeliveryDepth >= deliveryDepthIncrement);
+        eventDeliveryDepth -= deliveryDepthIncrement;
+    });
+    suspendResumeControl->sendPendingEvents();
+    return true;
+}
+
+bool QEventDispatcherWasm::sendPendingApplicationEventsFromBrowser()
+{
+    if (!emscripten_is_main_runtime_thread())
+        return false;
+    Q_ASSERT(emscripten_is_main_runtime_thread());
+
+    QEventDispatcherWasm *eventDispatcher = g_mainThreadEventDispatcher;
+    QWasmSuspendResumeControl *suspendResumeControl =
+            g_mainThreadSuspendResumeControl;
+    if (!eventDispatcher || !suspendResumeControl)
+        return true;
+
+    const emscripten::val control =
+            QWasmSuspendResumeControl::suspendResumeControlJs();
+    if (control["exclusiveEventHandler"].as<int>() > 0
+        || eventDeliveryDepth > 0) {
+        return false;
+    }
+
+    // In early-main-return mode there is no exec() stack to resume. Supply one
+    // non-blocking Qt cycle from the retained browser pump, while preventing a
+    // queued wakeup handler from recursively entering the dispatcher.
+    ++eventDeliveryDepth;
+    const auto eventDeliveryDepthGuard = qScopeGuard([] {
+        Q_ASSERT(eventDeliveryDepth > 0);
+        --eventDeliveryDepth;
+    });
+    eventDispatcher->sendPostedEvents();
+    if (!isValidEventDispatcherPointer(eventDispatcher))
+        return true;
+
+    suspendResumeControl->sendPendingEvents();
+    if (!isValidEventDispatcherPointer(eventDispatcher))
+        return true;
+
+    eventDispatcher->sendTimerEvents();
+    if (!isValidEventDispatcherPointer(eventDispatcher))
+        return true;
+
+    // Early-main-return mode has no outer exec() level to admit deferred
+    // deletes. Match Qt's externally pumped event-cycle pattern by
+    // flushing them after the complete posted/native/timer cycle.
+    QCoreApplication::sendPostedEvents(nullptr, QEvent::DeferredDelete);
+    if (!isValidEventDispatcherPointer(eventDispatcher))
+        return true;
+
+    return true;
+}
