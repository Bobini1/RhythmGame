From 24205cda961ca1138e60e715c5334e344a8e9373 Mon Sep 17 00:00:00 2001
From: Tomasz Kalisiak <tomasz.kalisiak3@gmail.com>
Date: Fri, 15 May 2026 15:17:12 +0200
Subject: [PATCH] QQuickWindow: Avoid full item-tree scans for child window stacking

Keep a list of QQuickWindowContainer items per QQuickWindow and use
that list when child windows need to be restacked.

This avoids scheduling updateChildWindowStackingOrder() for ordinary
ChildrenStackingChanged dirtiness in scenes that do not contain any
WindowContainer items. Such scenes do not need child-window restacking,
so walking the whole QQuickItem tree only adds polish-time overhead.

When containers are present, sort the registered containers by
paint order before raising their contained windows. This keeps the
existing stacking behavior while making the common no-container case
constant time.

Add tests for visibility changes with and without WindowContainer items
so the dirty flag is only set when restacking can actually be needed.

[ChangeLog][QtQuick][QQuickWindowContainer] Avoided unnecessary
child-window stacking updates in windows that do not contain any
WindowContainer items. This can reduce polish time in large Qt Quick
scenes when item visibility or stacking changes.

Fixes: QTBUG-134949
Change-Id: Ib4b98ebac020b33ca2067f321046df68802d1792
---

diff --git a/src/quick/items/qquickwindow.cpp b/src/quick/items/qquickwindow.cpp
index a8bbb72..60b1086 100644
--- a/src/quick/items/qquickwindow.cpp
+++ b/src/quick/items/qquickwindow.cpp
@@ -58,6 +58,7 @@
 
 #include <rhi/qrhi.h>
 
+#include <algorithm>
 #include <utility>
 #include <mutex>
 
@@ -883,8 +884,10 @@
     Q_Q(QQuickWindow);
 
     QQuickItemPrivate *itemPriv = QQuickItemPrivate::get(item);
-    if (itemPriv->dirtyAttributes & QQuickItemPrivate::ChildrenStackingChanged)
+    if (!childWindowContainers.isEmpty()
+        && (itemPriv->dirtyAttributes & QQuickItemPrivate::ChildrenStackingChanged)) {
         needsChildWindowStackingOrderUpdate = true;
+    }
 
     q->maybeUpdate();
 }
@@ -1767,32 +1770,92 @@
     QWindowPrivate::maybeSynthesizeContextMenuEvent(event);
 }
 
-void QQuickWindowPrivate::updateChildWindowStackingOrder(QQuickItem *item)
+void QQuickWindowPrivate::addChildWindowContainer(QQuickWindowContainer *windowContainer)
+{
+    Q_ASSERT(windowContainer);
+
+    if (childWindowContainers.contains(windowContainer))
+        return;
+
+    childWindowContainers.append(windowContainer);
+    needsChildWindowStackingOrderUpdate = true;
+}
+
+void QQuickWindowPrivate::removeChildWindowContainer(QQuickWindowContainer *windowContainer)
+{
+    childWindowContainers.removeOne(windowContainer);
+
+    if (childWindowContainers.isEmpty())
+        needsChildWindowStackingOrderUpdate = false;
+}
+
+static QList<QQuickItem *> itemAncestorChain(QQuickItem *item)
+{
+    QList<QQuickItem *> ancestors;
+    for (auto *ancestor = item; ancestor; ancestor = ancestor->parentItem())
+        ancestors.prepend(ancestor);
+    return ancestors;
+}
+
+static bool itemPaintOrderLess(QQuickItem *lhs, QQuickItem *rhs)
+{
+    if (lhs == rhs)
+        return false;
+
+    const auto lhsAncestors = itemAncestorChain(lhs);
+    const auto rhsAncestors = itemAncestorChain(rhs);
+    qsizetype commonAncestorCount = 0;
+    const qsizetype ancestorCount = qMin(lhsAncestors.size(), rhsAncestors.size());
+    while (commonAncestorCount < ancestorCount
+           && lhsAncestors.at(commonAncestorCount) == rhsAncestors.at(commonAncestorCount)) {
+        ++commonAncestorCount;
+    }
+
+    if (commonAncestorCount == lhsAncestors.size())
+        return true;
+    if (commonAncestorCount == rhsAncestors.size())
+        return false;
+    if (commonAncestorCount == 0)
+        return false;
+
+    auto *commonAncestor = lhsAncestors.at(commonAncestorCount - 1);
+    auto *lhsChild = lhsAncestors.at(commonAncestorCount);
+    auto *rhsChild = rhsAncestors.at(commonAncestorCount);
+    const auto siblings = QQuickItemPrivate::get(commonAncestor)->paintOrderChildItems();
+
+    return siblings.indexOf(lhsChild) < siblings.indexOf(rhsChild);
+}
+
+void QQuickWindowPrivate::updateChildWindowStackingOrder()
 {
     Q_Q(QQuickWindow);
 
-    if (!item) {
-        qCDebug(lcQuickWindow) << "Updating child window stacking order for" << q;
-        item = contentItem;
-    }
-    auto *itemPrivate = QQuickItemPrivate::get(item);
-    const auto paintOrderChildItems = itemPrivate->paintOrderChildItems();
-    for (auto *child : paintOrderChildItems) {
-        if (auto *windowContainer = qobject_cast<QQuickWindowContainer*>(child)) {
-            auto *window = windowContainer->containedWindow();
-            if (!window) {
-                qCDebug(lcQuickWindow) << windowContainer << "has no contained window yet";
-                continue;
-            }
-            if (window->parent() != q) {
-                qCDebug(lcQuickWindow) << window << "is not yet child of this window";
-                continue;
-            }
-            qCDebug(lcQuickWindow) << "Raising" << window << "owned by" << windowContainer;
-            window->raise();
-        }
+    if (childWindowContainers.isEmpty())
+        return;
 
-        updateChildWindowStackingOrder(child);
+    qCDebug(lcQuickWindow) << "Updating child window stacking order for" << q;
+
+    auto childWindowContainersInPaintOrder = childWindowContainers;
+    std::stable_sort(childWindowContainersInPaintOrder.begin(),
+                     childWindowContainersInPaintOrder.end(),
+                     [](QQuickWindowContainer *lhs, QQuickWindowContainer *rhs) {
+                         return itemPaintOrderLess(lhs, rhs);
+                     });
+
+    for (auto *windowContainer : childWindowContainersInPaintOrder) {
+        Q_ASSERT(windowContainer->window() == q);
+
+        auto *window = windowContainer->containedWindow();
+        if (!window) {
+            qCDebug(lcQuickWindow) << windowContainer << "has no contained window yet";
+            continue;
+        }
+        if (window->parent() != q) {
+            qCDebug(lcQuickWindow) << window << "is not yet child of this window";
+            continue;
+        }
+        qCDebug(lcQuickWindow) << "Raising" << window << "owned by" << windowContainer;
+        window->raise();
     }
 }
 
