+void QQuickWindowContainerPrivate::setParentWindow(QQuickWindow *newParentWindow)
+{
+    Q_Q(QQuickWindowContainer);
+
+    if (parentWindow == newParentWindow)
+        return;
+
+    if (parentWindow)
+        QQuickWindowPrivate::get(parentWindow.data())->removeChildWindowContainer(q);
+
+    parentWindow = newParentWindow;
+
+    if (parentWindow)
+        QQuickWindowPrivate::get(parentWindow.data())->addChildWindowContainer(q);
+}
+
