@PACKAGE_INIT@

if(TARGET Backbeat::Backbeat)
    set(Backbeat_FOUND TRUE)
    return()
endif()

include(CMakeFindDependencyMacro)
set(_backbeat_prefix "${PACKAGE_PREFIX_DIR}")
find_dependency(unofficial-sqlite3 CONFIG)
find_dependency(zstd CONFIG)

if(NOT TARGET Backbeat::SQLite)
    add_library(Backbeat::SQLite INTERFACE IMPORTED)
    set_target_properties(Backbeat::SQLite PROPERTIES
        INTERFACE_LINK_LIBRARIES unofficial::sqlite3::sqlite3)
endif()

set(_backbeat_extra_libraries zstd::libzstd)
include("${CMAKE_CURRENT_LIST_DIR}/BackbeatTargets.cmake")
