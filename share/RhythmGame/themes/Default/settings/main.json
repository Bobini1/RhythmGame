{
  "$schema": "https://raw.githubusercontent.com/Bobini1/RhythmGame/refs/heads/master/schemas/themeSettings.json",
  "items": [
    {
      "name": {
        "en": "Fonts",
        "pl": "Czcionki",
        "zh_CN": "字体"
      },
      "type": "group",
      "description": {
        "en": "Fonts used by the main menu.",
        "pl": "Czcionki używane w menu głównym.",
        "zh_CN": "主菜单所使用的字体"
      },
      "items": [
        {
          "id": "mainTitleFont",
          "name": {
            "en": "Title Font",
            "pl": "Czcionka tytułu",
            "zh_CN": "标题字体"
          },
          "type": "font",
          "path": "scripts/common/fonts",
          "default": "file:NotoSans-VariableFont_wdth,wght.ttf"
        },
        {
          "id": "mainMenuFont",
          "name": {
            "en": "Menu Font",
            "pl": "Czcionka menu",
            "zh_CN": "菜单字体"
          },
          "type": "font",
          "path": "scripts/common/fonts",
          "default": "file:NotoSans-VariableFont_wdth,wght.ttf"
        },
        {
          "id": "mainDialogFont",
          "name": {
            "en": "Dialog Font",
            "pl": "Czcionka okien dialogowych",
            "zh_CN": "对话框字体"
          },
          "type": "font",
          "path": "scripts/common/fonts",
          "default": "file:NotoSans-VariableFont_wdth,wght.ttf"
        }
      ]
    }
  ]
}
